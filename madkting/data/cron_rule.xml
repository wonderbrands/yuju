<odoo>
    <data noupdate="1">
        
        <record id="yuju_scheduled_rule" model="ir.cron">
            <field name="name">Yuju Process Webhooks</field>
            <field name="model_id" ref="model_product_product"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="priority">5</field>
            <field name="user_id">2</field>
            <!-- <field name="doall">True</field> -->
            <field name="state">code</field>
            <field name="code">model.process_webhooks()</field>
        </record>

        <record id="yuju_process_scheduled_rule" model="ir.cron">
            <field name="name">Yuju Send Webhooks</field>
            <field name="model_id" ref="model_product_product"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="priority">5</field>
            <field name="user_id">2</field>
            <!-- <field name="doall">True</field> -->
            <field name="state">code</field>
            <field name="code">model.schedule_send_webhook()</field>
        </record>

    </data>
</odoo>

